# Copy to .env.local and fill in your key. Any OpenAI-compatible provider works
# (OpenAI, Google Gemini, OpenRouter, Groq, Together, a local Ollama/LM Studio
# server, ...). On a deployed instance, set the same three variables in the host's
# project settings instead; env changes only apply to the next deployment.

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Google Gemini, via its OpenAI-compatible endpoint. Prefer a pinned model over
# the gemini-flash-latest alias, which points at the newest release and is the
# first to return 503 when it is busy. Get a key at aistudio.google.com/apikey.
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash

# Only needed if Chrome/Chromium is not in a standard location.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
