# Copy to .env.local and fill in when you have an AI key.
# Any OpenAI-compatible provider works (OpenAI, OpenRouter, Groq, Together,
# a local Ollama/LM Studio server, ...).

AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Only needed if Chrome/Chromium is not in a standard location.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
